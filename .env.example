# Copy to .env.local and fill in (never commit .env.local).

# Connection string for a READ-ONLY role on your PostgreSQL-compatible database.
# Create the role with: psql "$DATABASE_URL" -v ON_ERROR_STOP=1 -v reader_password="..." -f db/readonly_role.sql
# TLS is controlled by the URL's sslmode parameter: disable | require | no-verify | verify-full
# (use no-verify for providers whose certificate chain can't be fully verified).
DATABASE_URL_READONLY=postgresql://dashboard_reader:<password>@localhost:5432/<database>?sslmode=disable

# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional; defaults to gpt-5.6-terra
# OPENAI_MODEL=

# Optional display settings (build-time; drive number/date formatting in charts)
# NEXT_PUBLIC_CURRENCY=USD
# NEXT_PUBLIC_LOCALE=en-US
