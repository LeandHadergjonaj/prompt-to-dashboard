# Copy to .env.local and fill in (never commit .env.local).

# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# OPTIONAL built-in connection, shared by every user of this deployment.
# With in-app onboarding (/app/connect) you don't need this at all.
# Must point at a READ-ONLY role (create one with db/readonly_role.sql — never
# an admin role). TLS is controlled by the URL's sslmode parameter:
# disable | require | no-verify | verify-full.
# DATABASE_URL_READONLY=postgresql://dashboard_reader:<password>@localhost:5432/<database>?sslmode=disable

# OPTIONAL key material for credential encryption + cookie signing.
# When unset, a key is generated once and stored at .data/secret.key.
# Set it in production so .data/ stays decryptable across hosts.
# APP_SECRET=

# Optional; defaults to gpt-5.6-terra
# OPENAI_MODEL=

# Optional display settings (build-time; drive number/date formatting in charts)
# NEXT_PUBLIC_CURRENCY=USD
# NEXT_PUBLIC_LOCALE=en-US
