{
  "name": "prompt-to-dashboard",
  "version": "0.1.0",
  "description": "Embeddable AI dashboard engine: plain-English questions become live, safety-guarded dashboards on top of your own PostgreSQL database.",
  "keywords": [
    "text-to-sql",
    "text-to-dashboard",
    "embedded-analytics",
    "llm",
    "dashboard",
    "openai",
    "nextjs",
    "postgres",
    "recharts",
    "data-visualization"
  ],
  "homepage": "https://github.com/LeandHadergjonaj/text-to-sql#readme",
  "bugs": {
    "url": "https://github.com/LeandHadergjonaj/text-to-sql/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LeandHadergjonaj/text-to-sql.git"
  },
  "license": "MIT",
  "author": "Leand Hadergjonaj",
  "engines": {
    "node": ">=20"
  },
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "introspect": "tsx scripts/introspect-schema.ts",
    "fixture:bigdb": "tsx scripts/fixture-bigdb.ts",
    "test:sqlguard": "tsx scripts/test-sqlguard.ts",
    "test:prompt": "tsx scripts/test-prompt.ts",
    "test:appstore": "tsx scripts/test-appstore.ts",
    "test": "tsx scripts/test-sqlguard.ts && tsx scripts/test-prompt.ts && tsx scripts/test-appstore.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "html-to-image": "^1.11.13",
    "libpg-query": "^17.7.3",
    "next": "15.5.20",
    "openai": "^5.23.2",
    "pg": "^8.22.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "3.9.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.20",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
